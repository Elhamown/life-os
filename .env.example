# SERVER ONLY. No NEXT_PUBLIC_ variables. Values must be entered securely in environment settings.
# Exact origin, without a trailing slash; HTTPS for all public hosts.
MADAR_APP_ORIGIN=
# Generate locally: npm run notion:password (copy only the resulting hash to settings).
MADAR_OWNER_PASSWORD_HASH=
# Independent random 32-byte keys, hex-encoded. Never commit real values.
MADAR_SESSION_SECRET=
MADAR_STORE_ENCRYPTION_KEY=
# Private PostgreSQL with verified TLS. Initialize internal tables via npm run notion:store:init.
DATABASE_URL=
# Enable only after licensed regular/medium/bold WOFF2 files are provisioned for this build.
MADAR_NEO_SANS_ENABLED=
# Separate internal Notion integration with Read content ONLY, deliberately shared sources only.
NOTION_DISCOVERY_TOKEN=
# Set to 1 only after reviewing the integration capabilities in Notion.
NOTION_DISCOVERY_READ_ONLY_ACK=

# External AI processing is disabled until explicitly acknowledged. Server-only.
MADAR_AI_API_KEY=
MADAR_AI_EXTERNAL_PROCESSING_ACK=
MADAR_AI_BASE_URL=https://api.openai.com/v1
MADAR_AI_MODEL=gpt-4.1-mini
MADAR_AI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Separate sync integration. Disabled by default; never reuse the audit token.
NOTION_SYNC_TOKEN=
NOTION_SYNC_WRITE_ACK=
NOTION_SYNC_TEST_ACK=
# Comma-separated data_source UUIDs, not database container IDs. Lists must be disjoint.
NOTION_SYNC_TEST_SOURCE_IDS=
NOTION_SYNC_WRITE_SOURCE_IDS=
